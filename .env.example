# Postgres connection string (Neon via Vercel Marketplace sets this automatically)
DATABASE_URL=

# Model of the research agent (Claude, called directly, not through the AI Gateway)
ANTHROPIC_API_KEY=

# Web search for the research agent (exa.ai)
EXA_API_KEY=

# Paggo's fake calendar. Without these, a local fake calendar is used.
AGENDA_URL=
AGENDA_TOKEN=

# ElevenLabs voice agent. The agent id is printed by scripts/voice-sync.mjs.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret the agenda tools send in x-tool-secret (same value given to voice-sync.mjs)
VOICE_TOOL_SECRET=
# Returned once when the post-call webhook is created in ElevenLabs
ELEVENLABS_WEBHOOK_SECRET=

# Password for /painel (browser basic auth). Empty = open, for local development only.
PANEL_PASSWORD=
