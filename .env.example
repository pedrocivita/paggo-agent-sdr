AGENDA_TOKEN=

# ElevenLabs voice agent (milestone 3)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Password for /painel (browser basic auth). Empty = open, for local development only.
PANEL_PASSWORD=
